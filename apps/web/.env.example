# ---------------------------------------------------------------------------
# Next.js web app. Copy to `.env.local` and fill in.
# Everything here is NEXT_PUBLIC_ and therefore visible in the browser; no
# secret belongs in this file. Secrets live in apps/api/.env.local.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with `sb_publishable_`). Designed to be public; the
# database is protected by row-level security, not by hiding this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the NestJS API. Must match the API's PORT, and this app's origin
# must appear in the API's WEB_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:3000
