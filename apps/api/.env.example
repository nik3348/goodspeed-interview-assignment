# ---------------------------------------------------------------------------
# NestJS API. Copy to `.env.local` and fill in.
# Validated at boot by apps/api/src/config/environment.ts — a missing or
# malformed value fails the process immediately rather than the first request.
# ---------------------------------------------------------------------------

# Port the API listens on. The web app defaults to expecting 3000.
PORT=3000

# Supabase project URL, e.g. https://abcdefgh.supabase.co
# Project settings -> Data API -> Project URL
SUPABASE_URL=

# Publishable key (starts with `sb_publishable_`). Safe to expose; it is used
# for the per-request client that carries the caller's access token, so
# row-level security still applies inside the API.
# Project settings -> API keys -> Publishable key
SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with `sb_secret_`). Bypasses row-level security, so it
# must never reach the browser. Reserved for work with no user to act as.
# Project settings -> API keys -> Secret keys
SUPABASE_SECRET_KEY=

# Comma-separated browser origins allowed to call this API.
WEB_ORIGINS=http://localhost:3001
