# ---------------------------------------------------------------------------
# NestJS API. Copy to `.env.local` and fill in.
# Validated at boot by apps/api/src/config/environment.ts — a missing or
# malformed value fails the process immediately rather than the first request.
# ---------------------------------------------------------------------------

# Port the API listens on. The web app defaults to expecting 3000.
PORT=3000

# Supabase project URL, e.g. https://abcdefgh.supabase.co
# Project settings -> Data API -> Project URL
SUPABASE_URL=

# Publishable key (starts with `sb_publishable_`). Safe to expose; it is used
# for the per-request client that carries the caller's access token, so
# row-level security still applies inside the API.
# Project settings -> API keys -> Publishable key
SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with `sb_secret_`). Bypasses row-level security, so it
# must never reach the browser. Reserved for work with no user to act as.
# Project settings -> API keys -> Secret keys
SUPABASE_SECRET_KEY=

# Comma-separated browser origins allowed to call this API.
WEB_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# AI provider
#
# Any service implementing the OpenAI API works here. Switching provider is a
# change to these values and nothing else — no application code is aware of
# which one is configured.
#
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1
#   Together    AI_BASE_URL=https://api.together.xyz/v1
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama      AI_BASE_URL=http://localhost:11434/v1   (no key needed)
# ---------------------------------------------------------------------------

AI_BASE_URL=https://api.openai.com/v1

# Optional: a local Ollama needs no credentials.
AI_API_KEY=

AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Optional per-role overrides. Useful for running chat on a hosted provider
# and embeddings on a local one; both fall back to AI_BASE_URL / AI_API_KEY.
# AI_CHAT_BASE_URL=
# AI_CHAT_API_KEY=
# AI_EMBEDDING_BASE_URL=http://localhost:11434/v1
# AI_EMBEDDING_API_KEY=

# Optional. When set, the provider is asked for this vector width — OpenAI's
# text-embedding-3-* family honours it by truncating. It must match the
# document_chunks.embedding column (1536); any other value is refused at boot.
# Leave unset to use whatever the model natively returns, which is checked
# against the column on the first embedding call.
# AI_EMBEDDING_DIMENSIONS=1536

# Inputs per embedding request. Providers differ in what they accept.
AI_EMBEDDING_BATCH_SIZE=96

AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
