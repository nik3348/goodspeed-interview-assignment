{
  "name": "my-turborepo",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "bootstrap": "pnpm install && pnpm db:push && pnpm db:types",
    "db:link": "pnpm --filter @repo/database db:link",
    "db:push": "pnpm --filter @repo/database db:push",
    "db:new": "pnpm --filter @repo/database db:new",
    "db:diff": "pnpm --filter @repo/database db:diff",
    "db:status": "pnpm --filter @repo/database db:status",
    "db:types": "pnpm --filter @repo/database db:types",
    "db:advisors": "pnpm --filter @repo/database db:advisors"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "pnpm": "12.4.1",
    "prettier": "3.9.6",
    "turbo": "^2.10.13"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.11.0"
  }
}
